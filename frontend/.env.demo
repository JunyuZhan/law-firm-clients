# 体验 Demo 环境变量（GitHub Pages 静态部署，使用 MSW Mock 后端）

# 启用 Mock 后端（main.ts 据此动态加载 MSW 并启动 worker）
VITE_DEMO_MODE=true

# API 使用相对路径；由 MSW 在浏览器内拦截 /api、/portal/api 等请求
VITE_API_BASE_URL=

# Fallback 默认值（后台未配置时使用）
VITE_APP_NAME=律师事务所客户服务系统（Demo）
VITE_APP_SHORT_NAME=律所客服系统
VITE_APP_SHORT_NAME_EN=Law Firm Service
VITE_APP_SLOGAN=专业 · 诚信 · 高效
VITE_LAW_FIRM_NAME=汇衡律师事务所
VITE_LAW_FIRM_WEBSITE=https://www.example-lawfirm.com
VITE_LOGO_URL=/law-firm-clients/logo.png
VITE_LOGO_COLLAPSED_URL=/law-firm-clients/logo.png
VITE_ICP_LICENSE=沪ICP备00000000号
